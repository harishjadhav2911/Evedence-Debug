# EvidenceDebug AI — Environment Configuration Example
# Copy this file to .env and configure your values.

# Security
DEBUG=False
SECRET_KEY=generate_a_secure_random_key_here_for_production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.vercel.app,.onrender.com,.railway.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.onrender.com,https://*.railway.app,http://localhost:8000,http://127.0.0.1:8000

# Google Gemini API Key (Official Google Gen AI SDK)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# RAG & Embedding Settings
# Embedding modes: "sentence-transformers" (local neural model) or "tfidf-svd" (lightweight local dense)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage paths
DATA_DIR=data
MAX_UPLOAD_SIZE_MB=25

